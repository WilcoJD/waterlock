{
  "name": "@ripvault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RipVault HTTP API (Node built-ins only: node:http, node:sqlite, node:crypto).",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/scripts/seed.ts",
    "prices:sync": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/scripts/sync-prices.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@ripvault/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.8.0"
  }
}
