# RipVault API configuration. Copy to apps/api/.env (loaded automatically by npm run dev/start/seed).
# Money values are integer pence. Empty values fall back to the defaults shown.

# development | test | production
NODE_ENV=development
PORT=4000
# Interface to bind (0.0.0.0 so a phone on the same Wi-Fi can reach the dev server).
HOST=0.0.0.0
# SQLite file (created if missing). Use :memory: for throwaway runs.
DATABASE_PATH=./data/ripvault.db

# HS256 signing secret for 30-day bearer tokens. REQUIRED (>= 32 chars) when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Sell-back offer in basis points of current market value (9000 = 90%).
BUYBACK_BPS=9000
# Packs whose expected value / price exceeds this are refused by admin odds changes and
# auto-deactivated by price sync (9500 = 95%).
MAX_PACK_RTP_BPS=9500

# Shipping
SHIPPING_FLAT_FEE_PENCE=399
# Shipments worth at least this ship free. Leave EMPTY (SHIPPING_FREE_OVER_PENCE=) for never free.
SHIPPING_FREE_OVER_PENCE=5000
# Comma separated ISO 3166-1 alpha-2 codes.
SHIPPING_COUNTRIES=GB
SHIPPING_MAX_ITEMS=50

# Wallet top-ups
TOPUP_MIN_PENCE=500
TOPUP_MAX_PENCE=50000
# Instant fake top-ups for development (defaults to 1 outside production). Always OFF in production.
DEV_TOPUPS=1
# Stripe Checkout top-ups: set BOTH to enable. The webhook endpoint is POST {PUBLIC_URL}/webhooks/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded/failed, checkout.session.expired).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public base URL of this API (Stripe redirects to {PUBLIC_URL}/payments/return?status=success|cancel).
PUBLIC_URL=http://localhost:4000

# Withdrawals (paid out manually by an admin)
WITHDRAWALS_ENABLED=1
WITHDRAWAL_MIN_PENCE=1000

# `npm run seed` creates/updates this admin account (both or neither).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The seed refuses to turn an EXISTING player account with ADMIN_EMAIL into the admin (anyone can register
# any email). Set to 1 only if you own that account: its password is reset and its sessions signed out.
ADMIN_PROMOTE_EXISTING=0
# Creates demo@ripvault.dev / ripvault-demo with £50 (defaults to 1 outside production; forbidden in production).
SEED_DEMO_USER=1

# Prices (`npm run prices:sync`)
# Optional pokemontcg.io API key (raises the rate limit).
POKEMONTCG_API_KEY=
# cardmarket (EUR trend price) or tcgplayer (USD market price)
PRICE_SOURCE=cardmarket
FX_EUR_GBP=0.86
FX_USD_GBP=0.79

# Abuse protection
# Requests per minute per IP on /auth/* (register, login).
AUTH_RATE_LIMIT_PER_MINUTE=10
# Number of trusted reverse proxies in front of the API that append to X-Forwarded-For (nginx
# $proxy_add_x_forwarded_for, AWS ALB, most PaaS routers): 1 for one proxy, 2 for e.g. CDN + load balancer.
# The client IP is the entry that many places from the RIGHT; anything left of it is client-supplied and
# ignored. 0 = not behind a proxy (use the socket address).
TRUST_PROXY=0
# One JSON log line per request (defaults to on, off when NODE_ENV=test).
LOG_REQUESTS=1
