   "html": "<section class=\"section section--tight\" aria-label=\"Availability by room and night\">\n      <div class=\"container\">\n        <div class=\"diary is-loading\" data-diary>\n          <div class=\"diary-controls\">\n            <button class=\"btn btn--outline diary-nav\" type=\"button\" data-diary-prev>&larr; Earlier</button>\n            <div class=\"field diary-jump\"><label for=\"diary-start\">Starting from</label><input id=\"diary-start\" type=\"date\" data-diary-start></div>\n            <button class=\"btn btn--outline diary-nav\" type=\"button\" data-diary-next>Later &rarr;</button>\n          </div>\n          <p class=\"diary-status small\" data-diary-status role=\"status\" aria-live=\"polite\"></p>\n          <div class=\"diary-scroll\" role=\"region\" aria-label=\"Availability calendar, scroll sideways for more dates\" tabindex=\"0\">\n            <div data-diary-grid></div>\n          </div>\n          <ul class=\"diary-legend small\" aria-label=\"Key\">\n            <li><span class=\"diary-key is-open\" aria-hidden=\"true\"></span>Available</li>\n            <li><span class=\"diary-key is-low\" aria-hidden=\"true\"></span>Last room</li>\n            <li><span class=\"diary-key is-full\" aria-hidden=\"true\"></span>Fully booked</li>\n            <li><span class=\"diary-key is-checkin\" aria-hidden=\"true\"></span>Your dates</li>\n          </ul>\n          <div class=\"diary-selection\" data-diary-selection hidden>\n            <p data-diary-selection-text></p>\n            <div class=\"btn-row mt-0\">\n              <a class=\"btn btn--primary\" data-diary-book href=\"book.html\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4\"/><path d=\"M8 2v4\"/><path d=\"M3 10h18\"/></svg>Book these dates</a>\n              <button class=\"btn btn--outline\" type=\"button\" data-diary-clear>Clear</button>\n            </div>\n          </div>\n          <p class=\"small muted diary-small\">Prices are a guide to the lowest nightly rate for one room. Your exact total, including any taxes or extras, is shown before you pay.</p>\n        </div>\n\n        <div class=\"diary-fallback\" data-diary-fallback hidden>\n          <h2>Check availability</h2>\n          <p>Choose your dates to see live availability and prices for every room.</p>\n          <div class=\"cloudbeds-picker\" data-cloudbeds-picker hidden></div>\n          <form class=\"booking-bar\" data-booking-form action=\"book.html\" method=\"get\" aria-label=\"Check availability and book\">\n          <div class=\"booking-bar__fields\">\n            <div class=\"field booking-bar__date\"><label for=\"diary-in\">Arrive</label><input id=\"diary-in\" name=\"checkin\" type=\"date\" required></div>\n            <div class=\"field booking-bar__date\"><label for=\"diary-out\">Depart</label><input id=\"diary-out\" name=\"checkout\" type=\"date\" required></div>\n            <div class=\"field booking-bar__num\"><label for=\"diary-adults\">Adults</label><select id=\"diary-adults\" name=\"adults\"><option value=\"1\">1</option><option value=\"2\" selected>2</option><option value=\"3\">3</option><option value=\"4\">4</option><option value=\"5\">5</option><option value=\"6\">6</option></select></div>\n            <div class=\"field booking-bar__num\"><label for=\"diary-kids\">Children</label><select id=\"diary-kids\" name=\"kids\"><option value=\"0\">0</option><option value=\"1\">1</option><option value=\"2\">2</option><option value=\"3\">3</option><option value=\"4\">4</option></select></div>\n            <div class=\"field booking-bar__room\"><label for=\"diary-room\">Room</label><select id=\"diary-room\" name=\"rid\"><option value=\"\">Any room</option><option value=\"148837309972637\">Single Room</option><option value=\"148838930526405\">Twin Room</option><option value=\"148839795253447\">Double Room</option><option value=\"158032272887993\">Family Room</option></select></div>\n            <div class=\"booking-bar__submit\"><button class=\"btn btn--primary\" type=\"submit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4\"/><path d=\"M8 2v4\"/><path d=\"M3 10h18\"/></svg>Check availability</button></div>\n          </div>\n          <input type=\"hidden\" name=\"currency\" value=\"gbp\">\n        </form>\n        </div>\n\n        <noscript>\n          <div class=\"diary-fallback\">\n            <h2>Check availability</h2>\n            <p>The calendar needs JavaScript. Choose your dates below to see live availability and prices, or call us on 01698 265588.</p>\n            <form class=\"booking-bar\" data-booking-form action=\"book.html\" method=\"get\" aria-label=\"Check availability and book\">\n          <div class=\"booking-bar__fields\">\n            <div class=\"field booking-bar__date\"><label for=\"nojs-in\">Arrive</label><input id=\"nojs-in\" name=\"checkin\" type=\"date\" required></div>\n            <div class=\"field booking-bar__date\"><label for=\"nojs-out\">Depart</label><input id=\"nojs-out\" name=\"checkout\" type=\"date\" required></div>\n            <div class=\"field booking-bar__num\"><label for=\"nojs-adults\">Adults</label><select id=\"nojs-adults\" name=\"adults\"><option value=\"1\">1</option><option value=\"2\" selected>2</option><option value=\"3\">3</option><option value=\"4\">4</option><option value=\"5\">5</option><option value=\"6\">6</option></select></div>\n            <div class=\"field booking-bar__num\"><label for=\"nojs-kids\">Children</label><select id=\"nojs-kids\" name=\"kids\"><option value=\"0\">0</option><option value=\"1\">1</option><option value=\"2\">2</option><option value=\"3\">3</option><option value=\"4\">4</option></select></div>\n            <div class=\"field booking-bar__room\"><label for=\"nojs-room\">Room</label><select id=\"nojs-room\" name=\"rid\"><option value=\"\">Any room</option><option value=\"148837309972637\">Single Room</option><option value=\"148838930526405\">Twin Room</option><option value=\"148839795253447\">Double Room</option><option value=\"158032272887993\">Family Room</option></select></div>\n            <div class=\"booking-bar__submit\"><button class=\"btn btn--primary\" type=\"submit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4\"/><path d=\"M8 2v4\"/><path d=\"M3 10h18\"/></svg>Check availability</button></div>\n          </div>\n          <input type=\"hidden\" name=\"currency\" value=\"gbp\">\n        </form>\n          </div>\n        </noscript>\n      </div>\n    </section>"
