   "type": "html",
   "html": "<section class=\"page-hero page-hero--plain\" aria-labelledby=\"page-title\">\n      <div class=\"container\">\n        <ol class=\"breadcrumb\"><li><a href=\"index.html\">Home</a></li><li aria-current=\"page\">Contact</li></ol>\n        <p class=\"eyebrow\">Get in touch</p>\n        <h1 id=\"page-title\">We&rsquo;d love to hear from you</h1>\n        <p class=\"lede\">Whether it&rsquo;s a room for tonight, a table in the restaurant or a wedding next year, the quickest way to reach us is by phone.</p>\n      </div>\n    </section>"
  },
  {
   "type": "html",
   "html": "<section class=\"section section--tight\" aria-labelledby=\"details-title\">\n      <div class=\"container\">\n        <h2 id=\"details-title\" class=\"visually-hidden\">Contact details</h2>\n        <div class=\"contact-cards\">\n          <div class=\"contact-card\">\n            <h3><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z\"/></svg>Call</h3>\n            <p><a href=\"tel:+441698265588\">01698 265588</a></p>\n            <p class=\"small muted\">For bookings, tables and general questions.</p>\n          </div>\n          <div class=\"contact-card\">\n            <h3><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m22 7-10 6L2 7\"/></svg>Email</h3>\n            <p><a href=\"mailto:liam@thebentleyhotel.co.uk\">liam@thebentleyhotel.co.uk</a></p>\n            <p class=\"small muted\">For wedding, function and group enquiries.</p>\n          </div>\n          <div class=\"contact-card\">\n            <h3><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4\"/><path d=\"M8 2v4\"/><path d=\"M3 10h18\"/></svg>Book a room</h3>\n            <p><a href=\"book.html\">Check availability online</a></p>\n            <p class=\"small muted\">Live rates and instant confirmation.</p>\n          </div>\n          <div class=\"contact-card\">\n            <h3><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>Visit</h3>\n            <p>19 High Road, Motherwell ML1 3HU</p>\n            <p class=\"small muted\"><a href=\"location.html\">Directions &amp; parking</a></p>\n          </div>\n        </div>\n      </div>\n    </section>"
  },
  {
   "type": "html",
   "html": "<section class=\"section section--cream\" aria-labelledby=\"form-title\">\n      <div class=\"container\">\n        <div class=\"split split--wide-text split--top\">\n          <div>\n            <h2 id=\"form-title\">Send an enquiry</h2>\n            <p>Tell us a little about what you&rsquo;re planning, and we&rsquo;ll get back to you. Sending the form opens your email app with your enquiry ready to send to the hotel.</p>\n            <form class=\"form mt-2\" data-mailto=\"liam@thebentleyhotel.co.uk\" action=\"mailto:liam@thebentleyhotel.co.uk\" method=\"post\" enctype=\"text/plain\">\n              <div class=\"form__row form__row--2\">\n                <div class=\"field\">\n                  <label for=\"f-name\">Your name</label>\n                  <input id=\"f-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required>\n                </div>\n                <div class=\"field\">\n                  <label for=\"f-type\">Enquiry about</label>\n                  <select id=\"f-type\" name=\"enquiry_type\">\n                    <option value=\"Room booking\">A room booking</option>\n                    <option value=\"Restaurant\">A table in the restaurant</option>\n                    <option value=\"Wedding\">A wedding</option>\n                    <option value=\"Function\">A function, meeting or celebration</option>\n                    <option value=\"Other\">Something else</option>\n                  </select>\n                </div>\n              </div>\n              <div class=\"form__row form__row--2\">\n                <div class=\"field\">\n                  <label for=\"f-email\">Email</label>\n                  <input id=\"f-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required>\n                </div>\n                <div class=\"field\">\n                  <label for=\"f-phone\">Phone (optional)</label>\n                  <input id=\"f-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\">\n                </div>\n              </div>\n              <div class=\"form__row form__row--2\">\n                <div class=\"field\">\n                  <label for=\"f-date\">Date (optional)</label>\n                  <input id=\"f-date\" name=\"date\" type=\"date\">\n                </div>\n                <div class=\"field\">\n                  <label for=\"f-guests\">Number of guests (optional)</label>\n                  <input id=\"f-guests\" name=\"guests\" type=\"number\" min=\"1\" max=\"200\" inputmode=\"numeric\">\n                </div>\n              </div>\n              <div class=\"field\">\n                <label for=\"f-message\">Your message</label>\n                <textarea id=\"f-message\" name=\"message\" required></textarea>\n              </div>\n              <div>\n                <button class=\"btn btn--dark\" type=\"submit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m22 7-10 6L2 7\"/></svg>Send enquiry</button>\n              </div>\n              <p class=\"small muted\" data-form-status role=\"status\" aria-live=\"polite\"></p>\n            </form>\n          </div>\n          <aside aria-labelledby=\"hours-title\">\n            <div class=\"feature\">\n              <h3 id=\"hours-title\">Good to know</h3>\n              <dl class=\"info-list\">\n                <div><dt>Check-in</dt><dd>From 2pm</dd></div>\n                <div><dt>Check-out</dt><dd>By 11am</dd></div>\n                <div><dt>Parking</dt><dd>Free, on site</dd></div>\n                <div><dt>WiFi</dt><dd>Free</dd></div>\n                <div><dt>Pets</dt><dd>Assistance animals only</dd></div>\n              </dl>\n              <p class=\"small muted mt-1\">Arriving late? Please call ahead with your arrival time.</p>\n            </div>\n          </aside>\n        </div>\n      </div>\n    </section>"
  }
