 "sections": [
  {
   "type": "html",
   "html": "<section class=\"page-hero\" aria-labelledby=\"page-title\">\n      <div class=\"page-hero__bg\"><picture><source type=\"image/webp\" srcset=\"assets/img/room-double-1-800.webp 800w, assets/img/room-double-1-lg.webp 1400w\" sizes=\"100vw\"><img src=\"assets/img/room-double-1-800.jpg\" srcset=\"assets/img/room-double-1-800.jpg 800w, assets/img/room-double-1-lg.jpg 1400w\" sizes=\"100vw\" width=\"800\" height=\"515\" alt=\"Double room with a bay window\" loading=\"eager\" decoding=\"async\" fetchpriority=\"high\"></picture></div>\n      <div class=\"container\">\n        <ol class=\"breadcrumb\"><li><a href=\"index.html\">Home</a></li><li aria-current=\"page\">Rooms</li></ol>\n        <p class=\"eyebrow\">Stay with us</p>\n        <h1 id=\"page-title\">Rooms at Bentley Hotel</h1>\n        <p class=\"lede\">Eighteen en-suite bedrooms in a Victorian house, 5 minutes&rsquo; walk from Motherwell station.</p>\n        <div class=\"btn-row\">\n          <a class=\"btn btn--primary\" href=\"book.html\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4\"/><path d=\"M8 2v4\"/><path d=\"M3 10h18\"/></svg>Check availability</a>\n          <a class=\"btn btn--light\" href=\"#compare\">Compare the rooms</a>\n        </div>\n      </div>\n    </section>"
  },
  {
   "type": "html",
   "html": "<section class=\"booking-strip\" aria-labelledby=\"booking-strip-title\">\n      <div class=\"container\">\n        <div class=\"booking-card\">\n          <h2 id=\"booking-strip-title\" class=\"booking-card__title\">Find your room</h2>\n          <form class=\"booking-bar\" data-booking-form action=\"book.html\" method=\"get\" aria-label=\"Check availability and book\">\n          <div class=\"booking-bar__fields\">\n            <div class=\"field booking-bar__date\"><label for=\"rooms-in\">Arrive</label><input id=\"rooms-in\" name=\"checkin\" type=\"date\" required></div>\n            <div class=\"field booking-bar__date\"><label for=\"rooms-out\">Depart</label><input id=\"rooms-out\" name=\"checkout\" type=\"date\" required></div>\n            <div class=\"field booking-bar__num\"><label for=\"rooms-adults\">Adults</label><select id=\"rooms-adults\" name=\"adults\"><option value=\"1\">1</option><option value=\"2\" selected>2</option><option value=\"3\">3</option><option value=\"4\">4</option><option value=\"5\">5</option><option value=\"6\">6</option></select></div>\n            <div class=\"field booking-bar__num\"><label for=\"rooms-kids\">Children</label><select id=\"rooms-kids\" name=\"kids\"><option value=\"0\">0</option><option value=\"1\">1</option><option value=\"2\">2</option><option value=\"3\">3</option><option value=\"4\">4</option></select></div>\n            <div class=\"field booking-bar__room\"><label for=\"rooms-room\">Room</label><select id=\"rooms-room\" name=\"rid\"><option value=\"\">Any room</option><option value=\"148837309972637\">Single Room</option><option value=\"148838930526405\">Twin Room</option><option value=\"148839795253447\">Double Room</option><option value=\"158032272887993\">Family Room</option></select></div>\n            <div class=\"booking-bar__submit\"><button class=\"btn btn--primary\" type=\"submit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4\"/><path d=\"M8 2v4\"/><path d=\"M3 10h18\"/></svg>Check availability</button></div>\n          </div>\n          <input type=\"hidden\" name=\"currency\" value=\"gbp\">\n        </form>\n          <p class=\"booking-card__note small\">Want to see every night at a glance? <a href=\"availability.html\">Open the availability calendar</a>.</p>\n        </div>\n      </div>\n    </section>"
