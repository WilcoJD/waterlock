   "html": "<section class=\"booking-strip\" aria-labelledby=\"booking-strip-title\">\n      <div class=\"container\">\n        <div class=\"booking-card\">\n          <h2 id=\"booking-strip-title\" class=\"booking-card__title\">Check availability &amp; book direct</h2>\n          <form class=\"booking-bar\" data-booking-form action=\"book.html\" method=\"get\" aria-label=\"Check availability and book\">\n          <div class=\"booking-bar__fields\">\n            <div class=\"field booking-bar__date\"><label for=\"home-in\">Arrive</label><input id=\"home-in\" name=\"checkin\" type=\"date\" required></div>\n            <div class=\"field booking-bar__date\"><label for=\"home-out\">Depart</label><input id=\"home-out\" name=\"checkout\" type=\"date\" required></div>\n            <div class=\"field booking-bar__num\"><label for=\"home-adults\">Adults</label><select id=\"home-adults\" name=\"adults\"><option value=\"1\">1</option><option value=\"2\" selected>2</option><option value=\"3\">3</option><option value=\"4\">4</option><option value=\"5\">5</option><option value=\"6\">6</option></select></div>\n            <div class=\"field booking-bar__num\"><label for=\"home-kids\">Children</label><select id=\"home-kids\" name=\"kids\"><option value=\"0\">0</option><option value=\"1\">1</option><option value=\"2\">2</option><option value=\"3\">3</option><option value=\"4\">4</option></select></div>\n            <div class=\"field booking-bar__room\"><label for=\"home-room\">Room</label><select id=\"home-room\" name=\"rid\"><option value=\"\">Any room</option><option value=\"148837309972637\">Single Room</option><option value=\"148838930526405\">Twin Room</option><option value=\"148839795253447\">Double Room</option><option value=\"158032272887993\">Family Room</option></select></div>\n            <div class=\"booking-bar__submit\"><button class=\"btn btn--primary\" type=\"submit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4\"/><path d=\"M8 2v4\"/><path d=\"M3 10h18\"/></svg>Check availability</button></div>\n          </div>\n          <input type=\"hidden\" name=\"currency\" value=\"gbp\">\n        </form>\n          <p class=\"booking-card__note small\">Live prices from our reservations diary. Prefer to browse? <a href=\"availability.html\">See the availability calendar</a>.</p>\n        </div>\n      </div>\n    </section>"
