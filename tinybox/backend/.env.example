# ---- General ----
PORT=8080
PUBLIC_URL=http://localhost:8080          # used for Stripe redirect URLs
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/tinybox.db
BRAND_NAME=TinyBox

# ---- Proxmox ----
# Set PROXMOX_MOCK=true to run everything without a real cluster.
PROXMOX_MOCK=true
PROXMOX_URL=https://pve.example.com:8006
PROXMOX_TOKEN_ID=tinybox@pve!api           # user@realm!tokenname
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_INSECURE_TLS=false                  # true if your PVE uses a self-signed cert
PROXMOX_NODES=                              # comma list; empty = all online nodes
PROXMOX_STORAGE=local-lvm
PROXMOX_TEMPLATE=local:vztmpl/alpine-3.20-default_20240908_amd64.tar.xz
PROXMOX_BRIDGE=vmbr1
PROXMOX_POOL=tinybox                        # optional resource pool
# Containers get a static IP on the NAT bridge derived from their VMID.
# VMID range must match infra/proxmox-setup.sh
VMID_MIN=10000
VMID_MAX=10999
NAT_SUBNET_PREFIX=10.77                     # container IP = 10.77.<hi>.<lo>/16
NAT_GATEWAY=10.77.0.1
PUBLIC_HOST=pve.example.com                 # what users SSH to
SSH_PORT_BASE=20000                         # ssh port = SSH_PORT_BASE + (vmid - VMID_MIN)

# ---- Free tier ----
FREE_HOURS_INITIAL=4
FREE_HOURS_PER_AD=1
FREE_MAX_HOURS_AHEAD=24
FREE_MAX_ADS_PER_DAY=12
FREE_MAX_TOTAL=200                          # cap on simultaneous free containers

# ---- Stripe ----
# Leave STRIPE_SECRET_KEY empty for "mock checkout" (orders auto-complete; dev only!)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AdMob rewarded ads (server-side verification) ----
# Set your SSV callback in AdMob to: https://YOUR_DOMAIN/api/ads/admob-ssv
ADMOB_AD_UNIT_IDS=                          # optional comma list to restrict accepted ad units
ALLOW_DEV_REWARDS=true                      # lets the app grant rewards without SSV. MUST be false in prod.

# ---- Admin ----
ADMIN_EMAILS=you@example.com
