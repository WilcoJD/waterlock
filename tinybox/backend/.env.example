# ---- General ----
PORT=8080
PUBLIC_URL=http://localhost:8080          # used for Stripe redirect URLs
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/tinybox.db
BRAND_NAME=Nimbus                      # your brand – shown everywhere, nothing upstream is

# ---- Proxmox ----
# Set PROXMOX_MOCK=true to run everything without a real cluster.
PROXMOX_MOCK=true
PROXMOX_URL=https://pve.example.com:8006
PROXMOX_TOKEN_ID=tinybox@pve!api           # user@realm!tokenname
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_INSECURE_TLS=false                  # true if your PVE uses a self-signed cert
PROXMOX_NODES=                              # comma list; empty = all online nodes
PROXMOX_STORAGE=local-lvm
PROXMOX_TEMPLATE=local:vztmpl/alpine-3.20-default_20240908_amd64.tar.xz
PROXMOX_BRIDGE=vmbr1
PROXMOX_POOL=tinybox                        # optional resource pool
# Containers get a static IP on the NAT bridge derived from their VMID.
# VMID range must match infra/proxmox-setup.sh
VMID_MIN=10000
VMID_MAX=10999
NAT_SUBNET_PREFIX=10.77                     # container IP = 10.77.<hi>.<lo>/16
NAT_GATEWAY=10.77.0.1
PUBLIC_HOST=pve.example.com                 # what users SSH to
SSH_PORT_BASE=20000                         # ssh port = SSH_PORT_BASE + (vmid - VMID_MIN)

# ---- Free tier ----
FREE_HOURS_INITIAL=4
FREE_HOURS_PER_AD=1
FREE_MAX_HOURS_AHEAD=24
FREE_MAX_ADS_PER_DAY=12
FREE_MAX_TOTAL=200                          # cap on simultaneous free containers

# ---- Stripe ----
# Leave STRIPE_SECRET_KEY empty for "mock checkout" (orders auto-complete; dev only!)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AdMob rewarded ads (server-side verification) ----
# Set your SSV callback in AdMob to: https://YOUR_DOMAIN/api/ads/admob-ssv
ADMOB_AD_UNIT_IDS=                          # optional comma list to restrict accepted ad units
ALLOW_DEV_REWARDS=true                      # lets the app grant rewards without SSV. MUST be false in prod.

# ---- Admin ----
ADMIN_EMAILS=you@example.com

# ==== Cloud reselling: UpCloud ====
# UPCLOUD_MOCK=true fakes UpCloud for development.
UPCLOUD_MOCK=true
UPCLOUD_TOKEN=                              # API token (or UPCLOUD_USERNAME/UPCLOUD_PASSWORD of an API sub-account)
UPCLOUD_USERNAME=
UPCLOUD_PASSWORD=
UPCLOUD_ZONE=de-fra1
UPCLOUD_TEMPLATE=                           # storage UUID of a cloud-init template (e.g. Ubuntu 24.04)
UPCLOUD_NETWORK=                            # private SDN network UUID shared with the gateway
UPCLOUD_HIDE_METADATA=true                  # block 169.254.169.254 inside VMs after first boot

# ==== White-label gateway (see infra/gateway-setup.sh) ====
# Leave GATEWAY_URL empty to expose servers directly (not white-labelled).
GATEWAY_MOCK=false
GATEWAY_URL=                                # e.g. http://10.88.0.1:8787 (private network only)
GATEWAY_TOKEN=
GATEWAY_PUBLIC_HOST=ssh.nimbus.example      # what customers SSH to
GATEWAY_APPS_DOMAIN=apps.nimbus.example     # websites: <name>-<id>.apps.nimbus.example
GATEWAY_PRIVATE_IP=10.88.0.1                # VMs route all traffic through this
GATEWAY_PRIVATE_SUBNET=10.88.0.0/16
VPN_PREFIX=10.99

# ==== Unified wallet & spot exchange: OPEX (github.com/opexdev/core) ====
# OPEX_ENABLED=false uses the built-in ledger + order book (deposits credited by admins).
OPEX_ENABLED=false
OPEX_API_URL=http://api:8080                # OPEX api service
OPEX_WALLET_URL=http://wallet:8080          # OPEX wallet service – INTERNAL ONLY, never public
OPEX_KEYCLOAK_URL=http://keycloak:8080
OPEX_REALM=opex
OPEX_CLIENT_ID=web-app
OPEX_CLIENT_SECRET=
OPEX_KEYCLOAK_ADMIN_USER=admin
OPEX_KEYCLOAK_ADMIN_PASS=
OPEX_SECRET_KEY=                            # encrypts users' shadow-account passwords (32+ random chars)
OPEX_SYSTEM_ACCOUNTS={"default":"<opex-uuid-of-platform-account>"}
OPEX_GATEWAYS={"USDT:TRC20":"<gateway-uuid>","BTC:BTC":"<gateway-uuid>"}
OPEX_SPOT_PAIRS=BTC_USDT,ETH_USDT

# ==== Derivatives ====
DERIVATIVES_ENABLED=true                    # turn off for jurisdictions where you can't offer them
ORACLE_SOURCE=mock                          # mock | coinbase
PERPS_MAX_LEVERAGE=20
PERPS_FEE_BPS=5
PERPS_MAX_NOTIONAL=50000                    # per user, caps house exposure
OPTIONS_MAX_PREMIUM=10000
IV_BTC=0.55
IV_ETH=0.65
IV_SOL=0.85

# ==== Development helpers – MUST be false in production ====
ALLOW_FAUCET=true                           # "Get test funds" button
MARKET_MAKER=true                           # demo liquidity on spot + card markets
